# Copy this file to .env.docker before starting Docker Compose.
# This file is for an isolated local development database only. Do not use it
# for a shared or public deployment.

POSTGRES_DB=multi_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-development-password-change-me
DATABASE_URL=postgresql://postgres:local-development-password-change-me@db:5432/multi_crm?schema=public

# This value is intentionally a development-only example. Each developer may
# generate a different key with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SESSION_SIGNING_SECRET=local-development-session-secret-change-me
APP_URL=http://localhost:3000

# Signup codes are printed only in this developer's Docker logs. Never enable
# this for a shared or public deployment.
EMAIL_DEV_LOG=true

# Every developer supplies credentials for OAuth apps and test workspaces they
# control. Leave a provider blank if it is not being tested.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/integrations/zoho/callback
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/api/integrations/clickup/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/connections/GOOGLE/callback
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/connections/OUTLOOK/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3000/api/calendar/connections/CALENDLY/callback
OPENAI_API_KEY=
