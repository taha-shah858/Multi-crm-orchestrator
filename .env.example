# PostgreSQL is the platform's operational data store. Keep real values in .env.local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multi_crm?schema=public"

# HubSpot public-app OAuth. Register the exact callback URL in HubSpot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/integrations/hubspot/callback"

# 32 random bytes encoded as base64 (for example: openssl rand -base64 32).
# Keep this stable: changing it makes stored integration credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Transitional local-development fallback only. OAuth replaces this with
# encrypted, per-connection credentials and new deployments should omit it.
HUBSPOT_ACCESS_TOKEN=

# Required when server-backed sessions replace the temporary development session.
SESSION_SIGNING_SECRET=

# Zoho CRM OAuth (Client CRM)
# Include ZohoCRM.org.READ and ZohoCRM.users.READ for verified organization review.
# ZOHO_REDIRECT_URI must share the APP_URL origin; enable Multi DC in Zoho
# if clients use different regions (with matching OAuth credentials).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI="http://localhost:3000/api/integrations/zoho/callback"

# ClickUp OAuth (Agent Personal CRM / Sales Tracker)
# Created in ClickUp -> Settings -> Integrations -> ClickUp API -> Create App
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI="http://localhost:3000/api/integrations/clickup/callback"

# Agent calendar connections (separate from signup OAuth)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/connections/GOOGLE/callback
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/connections/OUTLOOK/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3000/api/calendar/connections/CALENDLY/callback

CALENDAR_AI_PROVIDER=gemini
# Shared existing Gemini key: Copilot, scripts, proposal drafts and scheduling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional writing-only model override; otherwise uses GEMINI_MODEL.
GEMINI_CONTENT_MODEL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Verification and invitations: configure one delivery provider.
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3000
# Explicit local terminal-only testing, never production.
EMAIL_DEV_LOG=false
