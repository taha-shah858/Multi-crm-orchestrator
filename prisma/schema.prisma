generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmProvider {
  HUBSPOT
  SALESFORCE
  CLOSE
  GOHIGHLEVEL
  ACTIVECAMPAIGN
  ZOHO
  PIPEDRIVE
}

enum ConnectionStatus {
  CONNECTED
  DEGRADED
  AUTHENTICATION_REQUIRED
  ERROR
  DISCONNECTED
}

enum AuditAction {
  CLIENT_ACCOUNT_SELECTED
  CONTACT_IMPORT_REQUESTED
  CONTACT_IMPORT_COMPLETED
}

model Organization {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  clients   ClientAccount[]
  contacts  Contact[]
  audits    AuditLog[]
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  email          String          @unique
  name           String
  passwordHash   String?
  role           UserRole        @default(AGENT)
  status         UserStatus      @default(INVITED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess   ClientAssignment[]
  assignedLeads  Contact[]       @relation("AssignedContacts")
  audits         AuditLog[]

  @@index([organizationId])
}

model ClientAccount {
  id                       String          @id @default(cuid())
  organizationId           String
  name                     String
  brandName                String
  communicationIdentity    String?
  status                   ClientStatus    @default(ACTIVE)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentAssignments         ClientAssignment[]
  crmConnections           CrmConnection[]
  contacts                 Contact[]
  audits                   AuditLog[]

  @@index([organizationId])
}

model ClientAssignment {
  clientAccountId String
  userId          String
  assignedAt      DateTime      @default(now())
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientAccountId, userId])
  @@index([userId])
}

model CrmConnection {
  id                    String           @id @default(cuid())
  organizationId        String
  clientAccountId       String
  provider              CrmProvider
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  status                ConnectionStatus @default(DISCONNECTED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  clientAccount         ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  externalRecords       ExternalRecord[]

  @@unique([clientAccountId, provider])
  @@index([organizationId, clientAccountId])
}

model Contact {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String
  assignedAgentId String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  assignedAgent   User?         @relation("AssignedContacts", fields: [assignedAgentId], references: [id])
  externalRecords ExternalRecord[]

  @@index([organizationId, clientAccountId])
  @@index([assignedAgentId])
  @@index([email])
  @@index([phone])
}

model ExternalRecord {
  id              String        @id @default(cuid())
  clientAccountId String
  contactId       String
  connectionId    String
  externalId      String
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([clientAccountId, contactId])
}

model AuditLog {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String?
  userId          String?
  action          AuditAction
  entityType      String
  entityId        String?
  source          String
  requestId       String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, createdAt])
  @@index([requestId])
}
