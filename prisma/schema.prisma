generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IntegrationProvider {
  HUBSPOT
  MOCK
  SALESFORCE
  CLOSE
  GOHIGHLEVEL
  ACTIVECAMPAIGN
  ZOHO
  PIPEDRIVE
  TWILIO
  GOOGLE_CALENDAR
  OUTLOOK
  AI_PROVIDER
}

enum IntegrationOwnershipType {
  COMPANY
  CLIENT_ACCOUNT
  USER
}

enum ConnectionStatus {
  CONNECTED
  DEGRADED
  AUTHENTICATION_REQUIRED
  ERROR
  DISCONNECTED
}

enum AuditAction {
  AUTH_SIGNED_IN
  AUTH_SIGNED_OUT
  USER_CREATED
  USER_UPDATED
  CLIENT_ACCOUNT_CREATED
  CLIENT_ACCOUNT_UPDATED
  CLIENT_ASSIGNMENTS_UPDATED
  CLIENT_ACCOUNT_SELECTED
  CONTACT_IMPORT_REQUESTED
  CONTACT_IMPORT_COMPLETED
  CONTACT_SYNC_STARTED
  CONTACT_SYNC_COMPLETED
  CONTACT_SYNC_FAILED
  CONTACT_UPDATED
  CONTACT_OUTBOUND_SYNC_COMPLETED
  CONTACT_OUTBOUND_SYNC_FAILED
  INTERACTION_CREATED
  COMMUNICATION_DISPATCHED
  COMMUNICATION_MANUALLY_LOGGED
  LEAD_ANALYSIS_CREATED
  LEAD_ANALYSIS_UPDATED
  SCRIPT_CREATED
  SCRIPT_UPDATED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  DEAL_CREATED
  COMMISSION_CREATED
  COMMISSION_UPDATED
  COMMISSION_LEDGER_ADJUSTED
  TIME_LOG_CREATED
  TIME_LOG_UPDATED
  DOCUMENT_CREATED
  DOCUMENT_GENERATED
  DOCUMENT_UPDATED
  DOCUMENT_UPLOADED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  INTEGRATION_OAUTH_FAILED
  INTEGRATION_CREDENTIAL_REFRESH_FAILED
  INTEGRATION_SYNC_RETRIED
}

enum ScriptChannel {
  CALL
  SMS
  EMAIL
}

enum ScriptSource {
  GENERATED
  MANUAL
  TEMPLATE
}

enum InteractionType {
  CALL
  SMS
  EMAIL
  NOTE
  CRM_ACTIVITY
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum InteractionSource {
  MANUAL
  HUBSPOT
  MOCK
  TWILIO
}

enum LeadAnalysisSource {
  MANUAL_TRANSCRIPT
  INTERACTION
}

enum LeadAnalysisProvider {
  RULES_ENGINE
}

enum CommunicationProvider {
  TWILIO
  MOCK
}

enum CalendarProvider {
  MANUAL
  MOCK
  GOOGLE
  OUTLOOK
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
}

enum AppointmentSource {
  MANUAL
  INTENT_DETECTED
}

enum DealStatus {
  OPEN
  CLOSED_WON
  CLOSED_LOST
}

enum CommissionStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum CommissionSource {
  MANUAL
}

enum LedgerEntryType {
  EXPECTED
  PAYMENT
  ADJUSTMENT
}

enum TimeLogSource {
  MANUAL
}

enum DocumentType {
  PROPOSAL
  FOLLOW_UP_EMAIL
  FOLLOW_UP_MESSAGE
  MANUAL_NOTE
  FILE_UPLOAD
}

enum DocumentSource {
  GENERATED
  MANUAL
  UPLOADED
}

enum DocumentStatus {
  DRAFT
  FINAL
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
}

model Organization {
  id                      String                  @id @default(cuid())
  name                    String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  users                   User[]
  clients                 ClientAccount[]
  contacts                Contact[]
  audits                  AuditLog[]
  syncRuns                SyncRun[]
  interactions            Interaction[]
  communicationIdentities CommunicationIdentity[]
  leadAnalyses            LeadAnalysis[]
  salesScripts            SalesScript[]
  appointments            Appointment[]
  deals                   Deal[]
  commissionRecords       CommissionRecord[]
  commissionLedgerEntries CommissionLedgerEntry[]
  timeLogs                TimeLog[]
  documents               Document[]
  integrationConnections  IntegrationConnection[]
  oauthStates             OAuthState[]
}

model User {
  id                      String                  @id @default(cuid())
  organizationId          String
  email                   String                  @unique
  name                    String
  passwordHash            String?
  role                    UserRole                @default(AGENT)
  status                  UserStatus              @default(INVITED)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess            ClientAssignment[]
  assignedLeads           Contact[]               @relation("AssignedContacts")
  audits                  AuditLog[]
  syncRuns                SyncRun[]
  interactions            Interaction[]
  leadAnalyses            LeadAnalysis[]
  salesScripts            SalesScript[]
  appointments            Appointment[]
  deals                   Deal[]
  commissionRecords       CommissionRecord[]
  commissionLedgerEntries CommissionLedgerEntry[]
  timeLogs                TimeLog[]
  documents               Document[]
  sessions                AuthSession[]
  ownedIntegrations       IntegrationConnection[] @relation("IntegrationOwner")
  connectedIntegrations   IntegrationConnection[] @relation("IntegrationConnectedBy")
  ownedOAuthStates        OAuthState[]             @relation("OAuthStateOwner")
  initiatedOAuthStates    OAuthState[]             @relation("OAuthStateInitiator")

  @@index([organizationId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ClientAccount {
  id                      String                  @id @default(cuid())
  organizationId          String
  name                    String
  brandName               String
  communicationIdentity   String?
  status                  ClientStatus            @default(ACTIVE)
  allowAgentIntegrationManagement Boolean         @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentAssignments        ClientAssignment[]
  integrationConnections  IntegrationConnection[]
  oauthStates             OAuthState[]
  contacts                Contact[]
  audits                  AuditLog[]
  syncRuns                SyncRun[]
  interactions            Interaction[]
  communicationIdentities CommunicationIdentity[]
  leadAnalyses            LeadAnalysis[]
  salesScripts            SalesScript[]
  appointments            Appointment[]
  deals                   Deal[]
  commissionRecords       CommissionRecord[]
  commissionLedgerEntries CommissionLedgerEntry[]
  timeLogs                TimeLog[]
  documents               Document[]

  @@index([organizationId])
}

model ClientAssignment {
  clientAccountId String
  userId          String
  assignedAt      DateTime      @default(now())
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientAccountId, userId])
  @@index([userId])
}

model IntegrationConnection {
  id                  String                   @id @default(cuid())
  organizationId      String
  ownershipType       IntegrationOwnershipType @default(CLIENT_ACCOUNT)
  ownershipKey        String
  clientAccountId     String?
  userId              String?
  provider            IntegrationProvider
  providerAccountId   String?
  providerAccountName String?
  status              ConnectionStatus         @default(DISCONNECTED)
  scopes              String[]                 @default([])
  connectedByUserId   String?
  connectedAt         DateTime?
  lastSyncAt          DateTime?
  lastError           String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount       ClientAccount?           @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  owner               User?                    @relation("IntegrationOwner", fields: [userId], references: [id], onDelete: Cascade)
  connectedBy         User?                    @relation("IntegrationConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  credential          IntegrationCredential?
  externalRecords     ExternalRecord[]
  syncRuns            SyncRun[]

  @@unique([ownershipKey, provider])
  @@index([organizationId, ownershipType, status])
  @@index([clientAccountId, provider])
  @@index([userId, provider])
  @@map("CrmConnection")
}

model IntegrationCredential {
  id                    String                @id @default(cuid())
  integrationConnectionId String              @unique
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  connection            IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)

  @@index([accessTokenExpiresAt])
}

model OAuthState {
  id                String                   @id @default(cuid())
  stateHash         String                   @unique
  provider          IntegrationProvider
  organizationId    String
  ownershipType     IntegrationOwnershipType
  clientAccountId   String?
  userId            String?
  initiatedByUserId String
  returnPath        String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime                 @default(now())
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount     ClientAccount?           @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  owner             User?                    @relation("OAuthStateOwner", fields: [userId], references: [id], onDelete: Cascade)
  initiatedBy       User                     @relation("OAuthStateInitiator", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@index([organizationId, provider])
}

model Contact {
  id              String           @id @default(cuid())
  organizationId  String
  clientAccountId String
  assignedAgentId String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  assignedAgent   User?            @relation("AssignedContacts", fields: [assignedAgentId], references: [id])
  externalRecords ExternalRecord[]
  interactions    Interaction[]
  leadAnalyses    LeadAnalysis[]
  salesScripts    SalesScript[]
  appointments    Appointment[]
  deals           Deal[]
  timeLogs        TimeLog[]
  documents       Document[]

  @@index([organizationId, clientAccountId])
  @@index([assignedAgentId])
  @@index([email])
  @@index([phone])
}

model ExternalRecord {
  id              String        @id @default(cuid())
  clientAccountId String
  contactId       String
  connectionId    String
  externalId      String
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([clientAccountId, contactId])
}

model AuditLog {
  id              String         @id @default(cuid())
  organizationId  String
  clientAccountId String?
  userId          String?
  action          AuditAction
  entityType      String
  entityId        String?
  source          String
  requestId       String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, createdAt])
  @@index([requestId])
}

model SyncRun {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String
  connectionId    String
  userId          String?
  provider        IntegrationProvider
  trigger         SyncTrigger   @default(MANUAL)
  status          SyncRunStatus @default(RUNNING)
  recordsRead     Int           @default(0)
  recordsCreated  Int           @default(0)
  recordsUpdated  Int           @default(0)
  recordsFailed   Int           @default(0)
  errorMessage    String?
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, startedAt])
  @@index([connectionId, status])
}

model Interaction {
  id              String               @id @default(cuid())
  organizationId  String
  clientAccountId String
  contactId       String?
  userId          String?
  type            InteractionType
  direction       InteractionDirection @default(INTERNAL)
  source          InteractionSource    @default(MANUAL)
  subject         String?
  body            String
  occurredAt      DateTime             @default(now())
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount        @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact         Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadAnalyses    LeadAnalysis[]
  appointments    Appointment[]

  @@index([organizationId, clientAccountId, occurredAt])
  @@index([contactId, occurredAt])
}

model LeadAnalysis {
  id               String               @id @default(cuid())
  organizationId   String
  clientAccountId  String
  contactId        String?
  interactionId    String?
  userId           String?
  source           LeadAnalysisSource
  provider         LeadAnalysisProvider @default(RULES_ENGINE)
  transcript       String
  summary          String
  budget           String?
  timeline         String?
  requirements     String?
  intent           String?
  objections       String?
  leadScore        Int
  temperature      String
  dealProbability  Int
  isManualOverride Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount        @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact          Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  interaction      Interaction?         @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesScripts     SalesScript[]
  documents        Document[]

  @@index([organizationId, clientAccountId, createdAt])
  @@index([contactId, createdAt])
  @@index([interactionId])
}

model SalesScript {
  id               String        @id @default(cuid())
  organizationId   String
  clientAccountId  String
  contactId        String?
  leadAnalysisId   String?
  userId           String?
  channel          ScriptChannel
  source           ScriptSource
  templateKey      String?
  title            String
  purpose          String
  content          String
  contextSnapshot  Json?
  isManualOverride Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadAnalysis     LeadAnalysis? @relation(fields: [leadAnalysisId], references: [id], onDelete: SetNull)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, createdAt])
  @@index([contactId, createdAt])
  @@index([leadAnalysisId])
}

model CommunicationIdentity {
  id              String                @id @default(cuid())
  organizationId  String
  clientAccountId String
  provider        CommunicationProvider
  label           String
  phoneNumber     String
  isDefault       Boolean               @default(false)
  isEnabled       Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount         @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, phoneNumber])
  @@index([organizationId, clientAccountId, isEnabled])
}

model Appointment {
  id               String            @id @default(cuid())
  organizationId   String
  clientAccountId  String
  contactId        String?
  interactionId    String?
  userId           String?
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  status           AppointmentStatus @default(SCHEDULED)
  provider         CalendarProvider  @default(MANUAL)
  source           AppointmentSource @default(MANUAL)
  externalId       String?
  externalMetadata Json?
  intentDetected   Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount     @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  interaction      Interaction?      @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, startTime])
  @@index([contactId, startTime])
  @@index([interactionId])
}

model Deal {
  id              String            @id @default(cuid())
  organizationId  String
  clientAccountId String
  contactId       String?
  userId          String?
  title           String
  valueCents      Int
  currency        String            @default("USD")
  status          DealStatus        @default(OPEN)
  closedAt        DateTime?
  notes           String?
  isManual        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount     @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact         Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  commission      CommissionRecord?
  documents       Document[]

  @@index([organizationId, clientAccountId, status])
  @@index([contactId])
}

model CommissionRecord {
  id               String                  @id @default(cuid())
  organizationId   String
  clientAccountId  String
  dealId           String?                 @unique
  userId           String?
  expectedCents    Int
  receivedCents    Int                     @default(0)
  currency         String                  @default("USD")
  status           CommissionStatus        @default(PENDING)
  source           CommissionSource        @default(MANUAL)
  notes            String?
  isManualOverride Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount           @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  deal             Deal?                   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  ledgerEntries    CommissionLedgerEntry[]

  @@index([organizationId, clientAccountId, status])
}

model CommissionLedgerEntry {
  id              String           @id @default(cuid())
  organizationId  String
  clientAccountId String
  commissionId    String
  userId          String?
  type            LedgerEntryType
  amountCents     Int
  note            String
  occurredAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  commission      CommissionRecord @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, occurredAt])
  @@index([commissionId, occurredAt])
}

model TimeLog {
  id               String        @id @default(cuid())
  organizationId   String
  clientAccountId  String
  contactId        String?
  userId           String?
  source           TimeLogSource @default(MANUAL)
  minutes          Int
  description      String
  loggedAt         DateTime      @default(now())
  isManualOverride Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, loggedAt])
  @@index([contactId, loggedAt])
}

model Document {
  id               String         @id @default(cuid())
  organizationId   String
  clientAccountId  String
  contactId        String?
  leadAnalysisId   String?
  dealId           String?
  userId           String?
  type             DocumentType
  source           DocumentSource
  status           DocumentStatus @default(DRAFT)
  title            String
  content          String?
  fileName         String?
  mimeType         String?
  fileData         Bytes?
  contextSnapshot  Json?
  isManualOverride Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount    ClientAccount  @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadAnalysis     LeadAnalysis?  @relation(fields: [leadAnalysisId], references: [id], onDelete: SetNull)
  deal             Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, updatedAt])
  @@index([contactId, updatedAt])
  @@index([leadAnalysisId])
  @@index([dealId])
}
