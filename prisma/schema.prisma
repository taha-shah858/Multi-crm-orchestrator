generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmProvider {
  HUBSPOT
  MOCK
  SALESFORCE
  CLOSE
  GOHIGHLEVEL
  ACTIVECAMPAIGN
  ZOHO
  PIPEDRIVE
}

enum ConnectionStatus {
  CONNECTED
  DEGRADED
  AUTHENTICATION_REQUIRED
  ERROR
  DISCONNECTED
}

enum AuditAction {
  CLIENT_ACCOUNT_SELECTED
  CONTACT_IMPORT_REQUESTED
  CONTACT_IMPORT_COMPLETED
  CONTACT_SYNC_STARTED
  CONTACT_SYNC_COMPLETED
  CONTACT_SYNC_FAILED
  INTERACTION_CREATED
  COMMUNICATION_DISPATCHED
  COMMUNICATION_MANUALLY_LOGGED
  LEAD_ANALYSIS_CREATED
  LEAD_ANALYSIS_UPDATED
  SCRIPT_CREATED
  SCRIPT_UPDATED
}

enum ScriptChannel {
  CALL
  SMS
  EMAIL
}

enum ScriptSource {
  GENERATED
  MANUAL
  TEMPLATE
}

enum InteractionType {
  CALL
  SMS
  EMAIL
  NOTE
  CRM_ACTIVITY
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum InteractionSource {
  MANUAL
  HUBSPOT
  MOCK
  TWILIO
}

enum LeadAnalysisSource {
  MANUAL_TRANSCRIPT
  INTERACTION
}

enum LeadAnalysisProvider {
  RULES_ENGINE
}

enum CommunicationProvider {
  TWILIO
  MOCK
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
}

model Organization {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  clients   ClientAccount[]
  contacts  Contact[]
  audits    AuditLog[]
  syncRuns  SyncRun[]
  interactions Interaction[]
  communicationIdentities CommunicationIdentity[]
  leadAnalyses LeadAnalysis[]
  salesScripts SalesScript[]
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  email          String          @unique
  name           String
  passwordHash   String?
  role           UserRole        @default(AGENT)
  status         UserStatus      @default(INVITED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess   ClientAssignment[]
  assignedLeads  Contact[]       @relation("AssignedContacts")
  audits         AuditLog[]
  syncRuns       SyncRun[]
  interactions   Interaction[]
  leadAnalyses   LeadAnalysis[]
  salesScripts   SalesScript[]

  @@index([organizationId])
}

model ClientAccount {
  id                       String          @id @default(cuid())
  organizationId           String
  name                     String
  brandName                String
  communicationIdentity    String?
  status                   ClientStatus    @default(ACTIVE)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentAssignments         ClientAssignment[]
  crmConnections           CrmConnection[]
  contacts                 Contact[]
  audits                   AuditLog[]
  syncRuns                 SyncRun[]
  interactions             Interaction[]
  communicationIdentities  CommunicationIdentity[]
  leadAnalyses             LeadAnalysis[]
  salesScripts             SalesScript[]

  @@index([organizationId])
}

model ClientAssignment {
  clientAccountId String
  userId          String
  assignedAt      DateTime      @default(now())
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientAccountId, userId])
  @@index([userId])
}

model CrmConnection {
  id                    String           @id @default(cuid())
  organizationId        String
  clientAccountId       String
  provider              CrmProvider
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  status                ConnectionStatus @default(DISCONNECTED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  clientAccount         ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  externalRecords       ExternalRecord[]
  syncRuns              SyncRun[]

  @@unique([clientAccountId, provider])
  @@index([organizationId, clientAccountId])
}

model Contact {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String
  assignedAgentId String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  assignedAgent   User?         @relation("AssignedContacts", fields: [assignedAgentId], references: [id])
  externalRecords ExternalRecord[]
  interactions     Interaction[]
  leadAnalyses     LeadAnalysis[]
  salesScripts     SalesScript[]

  @@index([organizationId, clientAccountId])
  @@index([assignedAgentId])
  @@index([email])
  @@index([phone])
}

model ExternalRecord {
  id              String        @id @default(cuid())
  clientAccountId String
  contactId       String
  connectionId    String
  externalId      String
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([clientAccountId, contactId])
}

model AuditLog {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String?
  userId          String?
  action          AuditAction
  entityType      String
  entityId        String?
  source          String
  requestId       String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, createdAt])
  @@index([requestId])
}

model SyncRun {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String
  connectionId    String
  userId          String?
  provider        CrmProvider
  trigger         SyncTrigger   @default(MANUAL)
  status          SyncRunStatus @default(RUNNING)
  recordsRead     Int           @default(0)
  recordsCreated  Int           @default(0)
  recordsUpdated  Int           @default(0)
  recordsFailed   Int           @default(0)
  errorMessage    String?
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, startedAt])
  @@index([connectionId, status])
}

model Interaction {
  id              String               @id @default(cuid())
  organizationId  String
  clientAccountId String
  contactId       String?
  userId          String?
  type            InteractionType
  direction       InteractionDirection @default(INTERNAL)
  source          InteractionSource    @default(MANUAL)
  subject         String?
  body            String
  occurredAt      DateTime             @default(now())
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount         @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact         Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadAnalyses    LeadAnalysis[]

  @@index([organizationId, clientAccountId, occurredAt])
  @@index([contactId, occurredAt])
}

model LeadAnalysis {
  id              String               @id @default(cuid())
  organizationId  String
  clientAccountId String
  contactId       String?
  interactionId   String?
  userId          String?
  source          LeadAnalysisSource
  provider        LeadAnalysisProvider @default(RULES_ENGINE)
  transcript      String
  summary         String
  budget          String?
  timeline        String?
  requirements    String?
  intent          String?
  objections      String?
  leadScore       Int
  temperature     String
  dealProbability Int
  isManualOverride Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount         @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact         Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  interaction     Interaction?          @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesScripts    SalesScript[]

  @@index([organizationId, clientAccountId, createdAt])
  @@index([contactId, createdAt])
  @@index([interactionId])
}

model SalesScript {
  id              String        @id @default(cuid())
  organizationId  String
  clientAccountId String
  contactId       String?
  leadAnalysisId  String?
  userId          String?
  channel         ScriptChannel
  source          ScriptSource
  templateKey     String?
  title           String
  purpose         String
  content         String
  contextSnapshot Json?
  isManualOverride Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount  @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadAnalysis    LeadAnalysis?  @relation(fields: [leadAnalysisId], references: [id], onDelete: SetNull)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientAccountId, createdAt])
  @@index([contactId, createdAt])
  @@index([leadAnalysisId])
}

model CommunicationIdentity {
  id              String                @id @default(cuid())
  organizationId  String
  clientAccountId String
  provider        CommunicationProvider
  label           String
  phoneNumber     String
  isDefault       Boolean               @default(false)
  isEnabled       Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount         @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, phoneNumber])
  @@index([organizationId, clientAccountId, isEnabled])
}
